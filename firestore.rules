rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User-scoped data
    match /users/{userId} {
      allow read, write: if true;
      
      match /executions/{document=**} {
        allow read, write: if true;
      }
      
      match /settings/{document=**} {
        allow read, write: if true;
      }
    }
    
    // Root executions feed
    match /executions/{document=**} {
      allow read, write: if true;
    }
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
